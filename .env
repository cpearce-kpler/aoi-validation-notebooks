# Inputs for entering data tables into any database

# Input data
INPUT_FILE_PATH=  # e.g. "C:\Users\Craig Pearce\Desktop\nav_met_zones_single.gpkg", use quotation marks here to account for whitespaces in the directory


# Inputs for entering data tables into MT

GEO_TYPE_NAME = NAV # GEO_TYPE input e.g. for NAVAREAs, this is NAV
ZONE_NAME = GEO_NAME_FULL # Column that contains the zone names e.g. GEO_NAME_FULL, zone_name, name, etc.
DB_CHOICE = DEV # DEV or PRIM
DELETE_EXISTING_DATA=false # true or false, remember that this will permanently delete all data under your chosen GEO_TYPE_NAME
USE_FAST_EXECUTEMANY = false # true or false, remember that executemany does not work with long wkt strings


# Inputs for entering data tables into maritime_assets

# Target table
TARGET_SCHEMA=ancillary
TARGET_TABLE=nav_met_zones

# Geometry / PK
GEOM_COL=geometry # What is the current name of the geometry column
ASSUME_CRS_IF_MISSING=EPSG:4326 # If the CRS is not set, do you want it to be set automatically? Set to EPSG:4326 to match database or None if not
PK_COL=id # Primary key column name - values under this columns will be regenerated if your chosen column has missing or duplicate data

# Choose to delete a data table with the same schema and table name
DROP_EXISTING_TABLE=False # Be sure that you want to delete an existing table before setting this to True

# Database credentials

# Input credentials - kp_daan
SQL_KP_USER=kp_daan
SQL_KP_PASSWORD= # Enter password
SQL_DEV_SERVER=192.168.100.130,1437
SQL_PRIM_SERVER=192.168.100.151,1433
SQL_DATABASE=ais_replica

# Input credentials - maritime
SQL_MA_HOST="maritime-assets-db1-dev-geospatial.cluster-cinsmmsxwkgg.eu-west-1.rds.amazonaws.com"
SQL_MA_DB="maritime_assets"
SQL_MA_USER= # Enter username
SQL_MA_PASS= # Enter password
